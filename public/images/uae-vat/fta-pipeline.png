<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="640" viewBox="0 0 1280 640" fill="none" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Background -->
  <rect width="1280" height="640" rx="16" fill="#ffffff" stroke="#d3e4fe" stroke-width="2"/>
  
  <!-- Central Pipeline Title -->
  <text x="640" y="50" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="20" font-weight="600" fill="#0b1c30">
    FTA Clearance Gateway Pipeline
  </text>
  <text x="640" y="72" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="14" fill="#6d7a72">
    End-to-End Architecture: ERP → Clearance → ECDSA Signing → Audit Archive
  </text>
  
  <!-- Pipeline Steps -->
  <!-- Step 1: ERP Source -->
  <rect x="80" y="120" width="200" height="100" rx="8" fill="#e5eeff" stroke="#006948" stroke-width="2"/>
  <text x="180" y="160" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="16" font-weight="600" fill="#0b1c30">ERP Source</text>
  <text x="180" y="180" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="12" fill="#3d4a42">Raw Transaction Events</text>
  
  <!-- Arrow -->
  <path d="M280 170 L320 170" stroke="#006948" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- Step 2: UBL/XML Transform -->
  <rect x="320" y="120" width="200" height="100" rx="8" fill="#e5eeff" stroke="#006948" stroke-width="2"/>
  <text x="420" y="160" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="16" font-weight="600" fill="#0b1c30">UBL 2.1 XML</text>
  <text x="420" y="180" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="12" fill="#3d4a42">Schema Validation</text>
  
  <!-- Arrow -->
  <path d="M520 170 L560 170" stroke="#006948" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- Step 3: SHA-256 Hash -->
  <rect x="560" y="120" width="200" height="100" rx="8" fill="#e5eeff" stroke="#006948" stroke-width="2"/>
  <text x="660" y="160" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="16" font-weight="600" fill="#0b1c30">SHA-256 Hash</text>
  <text x="660" y="180" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="12" fill="#3d4a42">Cryptographic Stamping</text>
  
  <!-- Arrow -->
  <path d="M760 170 L800 170" stroke="#006948" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- Step 4: ECDSA Sign -->
  <rect x="800" y="120" width="200" height="100" rx="8" fill="#e5eeff" stroke="#006948" stroke-width="2"/>
  <text x="900" y="150" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="14" font-weight="600" fill="#0b1c30">ECDSA Digital</text>
  <text x="900" y="170" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="14" font-weight="600" fill="#0b1c30">Signature</text>
  <text x="900" y="190" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="12" fill="#3d4a42">Invoice Sealing</text>
  
  <!-- Arrow -->
  <path d="M1000 170 L1040 170" stroke="#006948" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- Step 5: FTA Clearance -->
  <rect x="1040" y="120" width="200" height="100" rx="8" fill="#f5fff7" stroke="#006948" stroke-width="2" stroke-dasharray="4"/>
  <text x="1140" y="150" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="14" font-weight="600" fill="#006948">FTA</text>
  <text x="1140" y="170" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="14" font-weight="600" fill="#006948">Pre-Clearance</text>
  <text x="1140" y="190" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="12" fill="#005137">mTLS Gateway</text>
  
  <!-- Bottom Row: Archive -->
  <rect x="480" y="320" width="320" height="80" rx="8" fill="#e5eeff" stroke="#006948" stroke-width="2"/>
  <text x="640" y="365" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="16" font-weight="600" fill="#0b1c30">Cabinet Decision No. 52</text>
  <text x="640" y="385" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="12" fill="#3d4a42">5-Year Immutable Archive (WORM Compliant)</text>
  
  <!-- Arrow from ECDSA to Archive -->
  <path d="M900 230 C900 270 700 320 700 320" stroke="#006948" stroke-width="2" stroke-dasharray="4" marker-end="url(#arrowhead)"/>
  
  <!-- Arrow from FTA to Archive -->
  <path d="M1140 230 C1140 270 800 320 800 320" stroke="#006948" stroke-width="2" stroke-dasharray="4" marker-end="url(#arrowhead)"/>
  
  <!-- Arrowhead definition -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#006948"/>
    </marker>
  </defs>
</svg>
